<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>InformarCIOTeVPO</AssemblyName>
    <RootNamespace>InformarCIOTeVPO</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Willon Carlos (recovered)</Authors>
    <Description>Editor de CIOT e Vale Pedágio MDFe - Código fonte recuperado via engenharia reversa</Description>
    <PlatformTarget>x86</PlatformTarget>
    <!-- Original was net10.0-windows win-x86; using net8.0 for compatibility -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
